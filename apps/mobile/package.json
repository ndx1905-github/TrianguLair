  "description": "TrianguLair app (Expo / React Native, phase-0 skeleton)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
