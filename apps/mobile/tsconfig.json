{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    // The workspace packages are consumed from their TypeScript sources, which
    // import each other with explicit `.ts` extensions.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@triangulair/data": ["../../packages/data/src/index.ts"],
      "@triangulair/data/expo": ["../../packages/data/src/driver/expo.ts"],
      "@triangulair/osm": ["../../packages/osm/src/index.ts"],
      "@triangulair/import": ["../../packages/import/src/index.ts"],
      // The package sources' own dependencies, resolved from this app (the
      // packages may have no node_modules of their own).
      "yjs": ["./node_modules/yjs"],
      "fflate": ["./node_modules/fflate"],
      "opening_hours": ["./node_modules/opening_hours"],
      "expo-sqlite": ["./node_modules/expo-sqlite"],
      "geojson": ["./node_modules/@types/geojson"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "e2e", "playwright.config.ts"]
}
