{
  "expo": {
    "name": "TrianguLair",
    "slug": "triangulair",
    "version": "0.0.1",
    "orientation": "default",
    "scheme": "triangulair",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.triangulair.app",
      "supportsTablet": true
    },
    "android": {
      "package": "org.triangulair.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-sqlite",
        {
          "customBuildFlags": "-DSQLITE_ENABLE_RTREE=1"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TrianguLair uses Face ID to unlock the app when you turn on the app lock."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrianguLair uses the photo you choose as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "To center the map where you are. Your location stays on this device and is never sent."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
