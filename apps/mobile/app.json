{
  "expo": {
    "name": "TrianguLair",
    "slug": "triangulair",
    "version": "0.9.0",
    "orientation": "default",
    "scheme": "triangulair",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.triangulair.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:example.org"
      ]
    },
    "android": {
      "package": "org.triangulair.app",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "example.org",
              "path": "/i"
            },
            {
              "scheme": "https",
              "host": "example.org",
              "path": "/r"
            },
            {
              "scheme": "https",
              "host": "example.org",
              "path": "/l"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#1E40AF"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./public/icons/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "locationEngine": "default"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "customBuildFlags": "-DSQLITE_ENABLE_RTREE=1",
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TrianguLair uses Face ID to unlock the app when you turn on the app lock."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrianguLair uses the photo you choose as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "To center the map where you are. Your location stays on this device and is never sent."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TrianguLair uses the camera to scan a friend’s QR code: an invitation, an answer or a safety code.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
