{
  "name": "@triangulair/data",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "description": "TrianguLair local data: SQLite schema with spatial and full-text indexes, Yjs document (pure JavaScript CRDT) for the user's own data, list filters",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/driver/node.ts",
    "./expo": "./src/driver/expo.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run --exclude test/perf.test.ts",
    "test:perf": "PERF_REPORT=1 vitest run test/perf.test.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.1.1",
    "expo-sqlite": "~57.0.5",
    "fast-check": "^4.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11",
    "expo-sqlite": ">=57"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    }
  },
  "dependencies": {
    "yjs": "^13.6.33"
  }
}
