  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
